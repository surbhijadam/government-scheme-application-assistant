# Used ONLY by docker-compose, for the containers to talk to each other.
# Copy this to .env.docker and fill in real values before running
# `docker compose up`. This file is gitignored - never commit real secrets.

MYSQL_ROOT_PASSWORD=choose_a_strong_root_password
MYSQL_DATABASE=gov_scheme_db
MYSQL_USER=gov_app
MYSQL_PASSWORD=choose_a_strong_app_password

SECRET_KEY=generate_with_python_secrets_token_hex_32
GROQ_API_KEY=your_groq_api_key_here
FLASK_DEBUG=False